# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and is what the README
# tells you to copy. Without this negation `.env*` swallows it and a fresh
# clone has nothing to start from.
!.env.example

# vercel
.vercel

# Claude Code: los ajustes locales son de esta máquina (permisos, rutas) y no
# del proyecto. Declarado aquí y no solo en el gitignore global, para que
# siga protegido al clonar en otro sitio. launch.json sí se comparte: define
# cómo arrancar el servidor de desarrollo.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Frames intermedios de la grabacion de la demo (scripts/capture-demo.ts).
.demo-frames/

# El GIF que genera scripts/build-gif.ts se queda en local: pesa 6,6 MB y el
# README embebe solo docs/demo.webp, que es mas pequeno y de mejor calidad.
# Los binarios no se borran del historial de git, asi que solo entra el que
# se usa. El GIF sigue existiendo como respaldo para pegarlo donde no se
# renderice WebP animado.
docs/demo.gif
