[
  {"name":"Lovestruck","abilityCode":"PSV","slot":0,"description":"Hitting a Basic Attack grants a stack, or 2 stacks if the target is an enemy god.\n\n• Heart Bomb, Share the Love, and Fields of Love always consume up to 8 stacks on use, granting them additional Damage, Healing, and bonus effects","imgPath":"Gods/Cupid/Abilities/Icons_Cupid_Passive.png","levelStats":{"DamageIncrease":[2],"HealIncrease":[2],"MaxStacks":[16]},"namedFormulas":{},"namedValueScalings":{},"notes":[]},
  {"name":"Heart Bomb","abilityCode":"A01","slot":1,"description":"Fire an arrow of love, dealing Physical Damage to the first enemy hit and Slowing them.\n\n• After 3s, the enemy’s heart explodes, dealing Physical Damage to all enemies within the radius\n• If you have 8 stacks of Lovestruck, all enemies in the explosion area are Stunned","imgPath":"Gods/Cupid/Abilities/Icons_Cupid_A01.png","levelStats":{"InitialDamage":[50,80,110,140,170],"ExplosionDamage":[60,90,120,150,180],"MinionDamage":[60],"Slow":[20,20,20,20,20],"Stun":[0.8,0.8,0.8,0.8,0.8],"Range":[8.8],"Radius":[0.48],"ExplodeRadius":[4],"Cooldown":[12,12,12,12,12],"Cost":[60,65,70,75,80],"SlowDuration":[3],"SlowPercent":[20],"StunDuration":[0.8]},"namedFormulas":{"InitialDamage_Formula":"{InitialDamage} + {InitialDamageScaling_Scaling}","ExplosionDamage_Formula":"{ExplosionDamage} + {ExplosionDamageScaling_Scaling}","Heal_Formula":"{Heal} + {Heal_Scaling}","TalentInitialDamage_Formula":"{TalentInitialDamage} + {TalentInitialDamageScaling_Scaling}","TalentExplosionDamage_Formula":"{TalentExplosionDamage} + {TalentExplosionDamageScaling_Scaling}"},"namedValueScalings":{"InitialDamageScalingScaling":[{"values":[0.8,0.8,0.8,0.8,0.8],"statTag":"Character.Stat.PhysicalPower"},{"values":[0.55,0.55,0.55,0.55,0.55],"statTag":"Character.Stat.MagicalPower"}],"ExplosionDamageScalingScaling":[{"values":[0.55,0.55,0.55,0.55,0.55],"statTag":"Character.Stat.MagicalPower"},{"values":[0.8,0.8,0.8,0.8,0.8],"statTag":"Character.Stat.PhysicalPower"}]},"notes":[]},
