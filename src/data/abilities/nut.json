[
  {"name":"Flux","abilityCode":null,"slot":0,"description":"While Strength exceeds Intelligence, Ability hits grant Stellar Flux which provides Attack Speed. Stacks decay every 3s.\n\nOtherwise, Basic Attacks grant Astral Flux. Abilities consume this for Bonus Magical Damage and effects.\n\nBoth stack up to 10.","imgPath":"Gods/Nut/Ability/t_Icon_Nut_PSV.png","levelStats":{"BonusDamage":[10],"AttackSpeedPerLevel":[0.2],"AttackSpeedBase":[2],"Duration":[3],"MaxStacks":[10],"BuffDuration":[1.5],"BuffMaxStacks":[16]},"namedFormulas":{"AttackSpeedTotal":"{AttackSpeedBase} + {AttackSpeedPerLevel_Scaling}"},"namedValueScalings":{},"notes":[]},
