[
  {"name":"Marked for Death","abilityCode":"PSV","slot":0,"description":"Mark a god. Gain Physical Penetration against that god. Killing that god restores Health. Assists restore less Health. You also gain bonus gold bounty. Additionally, Basic Attacks and most abilities apply Rupture to enemies.\n\n• If a marked target dies, the enemy god closest to Kali becomes marked\n• You can use 'Interact' in the fountain to change your marked target","imgPath":"Gods/Kali/Abilities/Icons_Kali_Passive.png","levelStats":{},"namedFormulas":{"RuptureDamage_Formula":"{RuptureDamage} + {RuptureDamage_Scaling}","RuptureHeal_Formula":"{RuptureHeal} + {RuptureHeal_Scaling}"},"namedValueScalings":{"RuptureHealScaling":[{"values":[2,2,2,2,2],"statTag":"Character.Stat.Level"}],"RuptureDamageScaling":[{"values":[8,8,8,8,8],"statTag":"Character.Stat.Level"}]},"notes":[]},
  {"name":"Nimble Strike","abilityCode":"A01","slot":1,"description":"Leap dealing Physical Damage to enemies when landing. Heal Health if this ability landed on an enemy.\n\n• If you landed on an enemy god, heal for a percentage of their missing health\n• If you landed on multiple gods, restore based on the god that would heal you the most\n• Applies 2 stacks of Rupture","imgPath":"Gods/Kali/Abilities/Icons_Kali_A01.png","levelStats":{"Radius":[2.4,2.4,2.4,2.4,2.4],"Cost":[60,60,60,60,60],"Range":[8.8,8.8,8.8,8.8,8.8],"HealMissingHealth":[6,6,6,6,6],"HealFlat":[20,30,40,50,60],"Cooldown":[13,13,13,13,13],"Damage":[85,140,195,250,305]},"namedFormulas":{"Damage_Formula":"{Damage} + {Damage_Scaling}"},"namedValueScalings":{"DamageScaling":[{"values":[0.8,0.8,0.8,0.8,0.8],"statTag":"Character.Stat.PhysicalPower"}]},"notes":[]},
