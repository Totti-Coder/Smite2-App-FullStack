  {"name":"Shapeshift","abilityCode":"A04","slot":4,"description":"Artio Shapeshifts between her Druid stance and Bear stance.\n• When Artio hits at least 1 enemy with an ability, she gains one stack of Invigoration. Granting her Movement Speed and Mana Regeneration.\n• Stacks last 6 seconds, and can stack up to 8 times.\n• Stacks fall off one at a time.","imgPath":"Gods/Artio/Abilities/Icons_Artio_A04A.png","levelStats":{"BuffMaxStacks":[8],"Cooldown":[20,20,20,20,20],"MovementSpeed":[1,1.25,1.5,1.75,2],"ManaRegeneration":[0.4,0.8,1.2,1.6,2],"ManaPerTimeGranted":[0.4,0.8,1.2,1.6,2],"BuffDuration":[6]},"namedFormulas":{},"namedValueScalings":{},"notes":[]},
