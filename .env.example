# Copiar a .env.local y rellenar. .env* está en .gitignore: nunca se sube.
# Los valores salen de Supabase → Settings → API.

# Público: viaja al navegador por diseño (prefijo NEXT_PUBLIC_).
# La clave anónima no es un secreto — lo que protege los datos es Row Level
# Security, no ocultar esta clave.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Ignora RLS por completo: quien la tenga lee y escribe
# cualquier fila de cualquier usuario. Nunca le pongas el prefijo
# NEXT_PUBLIC_ y nunca la uses fuera de los scripts de sembrado.
SUPABASE_SERVICE_ROLE_KEY=

# SOLO SERVIDOR. Opcional: sin esto el indicador de directo simplemente no
# aparece, el resto de la aplicación funciona igual.
# Se obtienen en https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
